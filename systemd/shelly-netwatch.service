[Unit]
Description=Switches a Shelly by the reachability of a service on the network
Documentation=https://github.com/jamal2362/shelly-netwatch
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/shelly_netwatch.py --config /etc/shelly-netwatch.ini watch
Restart=always
RestartSec=10

# The service needs nothing from the system except the network.
DynamicUser=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
