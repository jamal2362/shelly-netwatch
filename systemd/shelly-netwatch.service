[Unit]
Description=Schaltet eine Shelly nach der Erreichbarkeit eines Dienstes im Netz
Documentation=https://github.com/CE-Repo/shelly-netwatch
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/shelly_netwatch.py --config /etc/shelly-netwatch.ini watch
Restart=always
RestartSec=10

# Der Dienst braucht nichts vom System ausser dem Netzwerk.
DynamicUser=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
